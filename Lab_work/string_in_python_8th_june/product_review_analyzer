# Customer Review Analysis

review = "This product is excellent excellent excellent and very useful"

# Convert review into list of words
words = review.split()

# 1. Count total words
total_words = len(words)

# 2. Create dictionary of word frequencies
freq = {}

for word in words:
    if word in freq:
        freq[word] += 1
    else:
        freq[word] = 1

# 3. Find most frequently used word
most_frequent = ""
max_count = 0

for word in freq:
    if freq[word] > max_count:
        max_count = freq[word]
        most_frequent = word

# 4. Find words appearing only once
once_words = []

for word in freq:
    if freq[word] == 1:
        once_words.append(word)

# 5. Count words having more than 5 characters
count_more_than_5 = 0

for word in words:
    if len(word) > 5:
        count_more_than_5 += 1

# 6. Display words in reverse order
reverse_words = words[::-1]

# 7. Create list of unique words
unique_words = []

for word in words:
    if word not in unique_words:
        unique_words.append(word)

# Display Results
print("Total Words:", total_words)

print("\nWord Frequencies:")
for word in freq:
    print(word, "->", freq[word])

print("\nMost Frequent Word:", most_frequent)

print("Words Appearing Once:", once_words)

print("Words Having More Than 5 Characters:", count_more_than_5)

print("Words in Reverse Order:", reverse_words)

print("Unique Words:", unique_words)