# Accept number of rows from user
rows = int(input("Enter number of rows: "))

# Outer loop for rows
for i in range(1, rows + 1):

    # Inner loop to print numbers from 1 to i
    for j in range(1, i + 1):
        print(j, end="")

    # Move to next line after each row
    print()

