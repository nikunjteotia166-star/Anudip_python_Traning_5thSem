# 1. Display all player statistics
print("All Player Statistics:")
for player, stats in players.items():
    print(player, stats)

# 2. Highest run scorer
highest_runs = max(players, key=lambda x: players[x]["runs"])
print("\nHighest Run Scorer:")
print(highest_runs, players[highest_runs])

# 3. Lowest run scorer
lowest_runs = min(players, key=lambda x: players[x]["runs"])
print("\nLowest Run Scorer:")
print(lowest_runs, players[lowest_runs])

# 4. Average runs
total_runs = sum(player["runs"] for player in players.values())
avg_runs = total_runs / len(players)

print("\nAverage Runs =", round(avg_runs, 2))

# 5. Player with maximum wickets
max_wickets = max(players, key=lambda x: players[x]["wickets"])

print("\nMaximum Wickets:")
print(max_wickets, players[max_wickets])

# 6. All-Rounders
print("\nAll-Rounders:")
for player, stats in players.items():
    if stats["runs"] > 300 and stats["wickets"] > 5:
        print(player, stats)

# 7. Players scoring above average
