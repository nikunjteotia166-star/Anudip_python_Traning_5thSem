while True:

    # Menu
    print("\n===== CITY DASHBOARD =====")
    print("1. Display All Cities")
    print("2. Most Populated City")
    print("3. Least Populated City")
    print("4. Average Population")
    print("5. Cities with Literacy > 90")
    print("6. Population Density")
    print("7. Highest Density City")
    print("8. City Categories")
    print("9. National Report")
    print("0. Exit")

    choice = int(input("Enter Choice: "))

    # 1. Display all city details
    if choice == 1:
        for city, data in cities.items():
            print(city, data)

    # 2. Most populated city
    elif choice == 2:
        max_city = ""
        max_pop = 0

        for city, data in cities.items():
            if data["population"] > max_pop:
                max_pop = data["population"]
                max_city = city

        print("Most Populated City =", max_city)

    # 3. Least populated city
    elif choice == 3:
        first = True

        for city, data in cities.items():

            if first:
                min_city = city
                min_pop = data["population"]
                first = False

            elif data["population"] < min_pop:
                min_pop = data["population"]
                min_city = city

        print("Least Populated City =", min_city)

    # 4. Average population
    elif choice == 4:
        total = 0

        for data in cities.values():
            total += data["population"]

        avg = total / len(cities)

        print("Average Population =", avg)

    # 5. Literacy above 90%
    elif choice == 5:
        print("High Literacy Cities")

        for city, data in cities.items():
            if data["literacy"] > 90:
                print(city)

    # 6. Population density
    elif choice == 6:
        print("Population Density")

        for city, data in cities.items():
            density = data["population"] / data["area"]
            print(city, "=", round(density, 2))

    # 7. Highest density city
    elif choice == 7:
        max_density = 0
        max_city = ""

        for city, data in cities.items():

            density = data["population"] / data["area"]

            if density > max_density:
                max_density = density
                max_city = city

        print("Highest Density City =", max_city)

    # 8. Categorize cities
    elif choice == 8:

        for city, data in cities.items():

            if data["population"] < 1000000:
                category = "Small"

            elif data["population"] <= 5000000:
                category = "Medium"

            else:
                category = "Large"

            print(city, ":", category)

    # 9. National summary report
    elif choice == 9:

        total_pop = 0

        for data in cities.values():
            total_pop += data["population"]

        print("\n===== NATIONAL REPORT =====")
        print("Total Cities =", len(cities))
        print("Total Population =", total_pop)
        print("Average Population =", total_pop / len(cities))

    # Exit
    elif choice == 0:
        print("Program Ended")
        break

    else:
        print("Invalid Choice")