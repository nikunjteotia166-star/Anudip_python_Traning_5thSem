# Password Security Analyzer

strong = 0
medium = 0
weak = 0

# Analyze 15 passwords
for i in range(15):

    password = input(f"\nEnter Password {i+1}: ")

    upper = 0
    lower = 0
    digits = 0
    special = 0
    vowels = 0
    consonants = 0
    has_space = False

    # Count different character types
    for ch in password:

        if ch.isupper():
            upper += 1

        elif ch.islower():
            lower += 1

        elif ch.isdigit():
            digits += 1

        else:
            special += 1

        # Check spaces
        if ch == " ":
            has_space = True

        # Count vowels and consonants
        if ch.isalpha():

            if ch.lower() in "aeiou":
                vowels += 1
            else:
                consonants += 1

    # Check repeated characters
    repeated = []

    for ch in password:
        if password.count(ch) > 1 and ch not in repeated:
            repeated.append(ch)

    # Find most frequent character
    max_count = 0
    frequent_char = ""

    for ch in password:

        count = password.count(ch)

        if count > max_count:
            max_count = count
            frequent_char = ch

    # Password strength
    if len(password) >= 8 and upper > 0 and lower > 0 and digits > 0 and special > 0:
        strength = "Strong"
        strong += 1

    elif len(password) >= 8:
        strength = "Medium"
        medium += 1

    else:
        strength = "Weak"
        weak += 1

    # Display Report
    print("\n----- PASSWORD REPORT -----")
    print("Password Length :", len(password))
    print("Uppercase Letters :", upper)
    print("Lowercase Letters :", lower)
    print("Digits :", digits)
    print("Special Characters :", special)
    print("Contains Space :", has_space)
    print("Vowels :", vowels)
    print("Consonants :", consonants)
    print("Repeated Characters :", repeated)
    print("Most Frequent Character :", frequent_char)
    print("Strength :", strength)

# Final Summary Report
print("\n========== SECURITY REPORT ==========")
print("Total Passwords Analyzed :", 15)
print("Strong Passwords :", strong)
print("Medium Passwords :", medium)
print("Weak Passwords :", weak)
print("=====================================")